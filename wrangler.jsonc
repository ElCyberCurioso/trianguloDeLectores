{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triangulo-de-lectores",
  "main": "src/server/index.tsx",
  "compatibility_date": "2025-02-04",
  // NOTA: sin "nodejs_compat" a proposito. Todo el codigo server-side usa
  // exclusivamente APIs Web estandar disponibles en workerd.
  "compatibility_flags": [],
  "workers_dev": false,
  "version_metadata": { "binding": "CF_VERSION" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_NAME": "Triángulo de Lectores",
    "SITE_URL": "http://localhost:8787",
    "SITE_LOCALE": "es-ES",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_ENABLED": "false",
    "IMAGE_RESIZING": "false",
    // Subdominio privado de la biblioteca. En local no vale el prefijo
    // `books.` sobre `localhost:8787`, así que se declara entero: `wrangler
    // dev` responde a cualquier Host, y basta con apuntar `books.localhost` a
    // 127.0.0.1 en /etc/hosts para probarlo.
    "BOOKS_URL": "http://books.localhost:8787",
    "LOG_LEVEL": "debug"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tdl-db",
      "database_id": "REPLACE_WITH_LOCAL_DEV_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tdl-media-dev" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_CACHE_KV_ID" },
    { "binding": "CONFIG", "id": "REPLACE_WITH_CONFIG_KV_ID" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "MODERATION", "class_name": "ModerationCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ModerationCoordinator"] }
  ],
  "env": {
    "staging": {
      "name": "triangulo-de-lectores-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_NAME": "Triángulo de Lectores (staging)",
        "SITE_URL": "https://staging.triangulodelectores.site",
        "SITE_LOCALE": "es-ES",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEeDd1vqq7WZ1s-I",
        "TURNSTILE_ENABLED": "true",
        // Las transformaciones no están activadas en la zona: con `true`,
        // `/cdn-cgi/image/…` devuelve 404 y no se ve ninguna portada. En
        // `false` se sirve el original con caché inmutable. Vuelve a `true`
        // cuando el producto esté activo en el panel.
        "IMAGE_RESIZING": "false",
        "BOOKS_URL": "https://books-staging.triangulodelectores.site",
        "LOG_LEVEL": "info"
      },
      "routes": [
        { "pattern": "staging.triangulodelectores.site", "custom_domain": true },
        { "pattern": "books-staging.triangulodelectores.site", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tdl-db-staging",
          "database_id": "e185f21a-e635-4733-95aa-f94048e60288",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tdl-media-staging" }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "3a86f302d4744157943928ff13f42c84" },
        { "binding": "CONFIG", "id": "479a8a31ae834f33a3fbd113938b8e5a" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "MODERATION", "class_name": "ModerationCoordinator" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ModerationCoordinator"] }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "version_metadata": { "binding": "CF_VERSION" },
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      // Mantenimiento diario: purga de sesiones caducadas y retención de auditoría.
      "triggers": { "crons": ["0 4 * * *"] }
    },
    "production": {
      "name": "triangulo-de-lectores-production",
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_NAME": "Triángulo de Lectores",
        "SITE_URL": "https://triangulodelectores.site",
        "SITE_LOCALE": "es-ES",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEeDMwghTFFCYU1g",
        "TURNSTILE_ENABLED": "true",
        // Igual que en staging: las Transformaciones de imagen no están
        // activadas en la zona —no entran en el plan Free—, y con `true` cada
        // portada pide `/cdn-cgi/image/…` y recibe un 404. En `false` se sirve
        // el original con caché inmutable. Vuelve a `true` el día que se
        // activen en el panel.
        "IMAGE_RESIZING": "false",
        "BOOKS_URL": "https://books.triangulodelectores.site",
        "LOG_LEVEL": "warn"
      },
      "routes": [
        { "pattern": "triangulodelectores.site", "custom_domain": true },
        { "pattern": "books.triangulodelectores.site", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tdl-db-prod",
          "database_id": "f58fc8e1-1f6f-44b4-afbb-a79d17bdbd7f",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tdl-media-prod" }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "b3bbb0b3f6af4888b6144eec3de038c5" },
        { "binding": "CONFIG", "id": "0726753e9d9e4968a08e0bfa6ac340e2" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "MODERATION", "class_name": "ModerationCoordinator" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ModerationCoordinator"] }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "version_metadata": { "binding": "CF_VERSION" },
      "observability": { "enabled": true, "head_sampling_rate": 0.5 },
      // Sin `limits: { cpu_ms: … }`: es de plan de pago. Aquí estuvo puesto en
      // 200 y dejó el Worker roto en producción —toda petición con E/S (D1,
      // KV, ASSETS) moría con `TypeError: Callback returned incorrect type;
      // expected 'Promise'`, un error del runtime anterior a `onError`, así
      // que el sitio devolvía 1101 y sólo respondía `/robots.txt`, el único
      // handler sin E/S—. Desde entonces la API lo rechaza al desplegar
      // (código 100328). Recupérable si algún día se pasa a plan de pago.
      // El `placement` de Smart Placement se hereda del nivel superior y no da
      // problemas: staging corre con él.
      // Mantenimiento diario: purga de sesiones caducadas y retención de auditoría.
      "triggers": { "crons": ["0 4 * * *"] }
    }
  }
}
