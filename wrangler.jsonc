{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triangulo-de-lectores",
  "main": "src/server/index.tsx",
  "compatibility_date": "2025-02-04",
  // NOTA: sin "nodejs_compat" a proposito. Todo el codigo server-side usa
  // exclusivamente APIs Web estandar disponibles en workerd.
  "compatibility_flags": [],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_NAME": "Triángulo de Lectores",
    "SITE_URL": "http://localhost:8787",
    "SITE_LOCALE": "es-ES",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_ENABLED": "false",
    "IMAGE_RESIZING": "false",
    "LOG_LEVEL": "debug"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tdl-db",
      "database_id": "REPLACE_WITH_LOCAL_DEV_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tdl-media-dev" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_CACHE_KV_ID" },
    { "binding": "CONFIG", "id": "REPLACE_WITH_CONFIG_KV_ID" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "MODERATION", "class_name": "ModerationCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ModerationCoordinator"] }
  ],
  "env": {
    "staging": {
      "name": "triangulo-de-lectores-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_NAME": "Triángulo de Lectores (staging)",
        "SITE_URL": "https://staging.triangulodelectores.com",
        "SITE_LOCALE": "es-ES",
        "TURNSTILE_SITE_KEY": "REPLACE_WITH_STAGING_TURNSTILE_SITE_KEY",
        "TURNSTILE_ENABLED": "true",
        "IMAGE_RESIZING": "true",
        "LOG_LEVEL": "info"
      },
      "routes": [
        { "pattern": "staging.triangulodelectores.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tdl-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tdl-media-staging" }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "REPLACE_WITH_STAGING_CACHE_KV_ID" },
        { "binding": "CONFIG", "id": "REPLACE_WITH_STAGING_CONFIG_KV_ID" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "MODERATION", "class_name": "ModerationCoordinator" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ModerationCoordinator"] }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      // Mantenimiento diario: purga de sesiones caducadas y retención de auditoría.
      "triggers": { "crons": ["0 4 * * *"] }
    },
    "production": {
      "name": "triangulo-de-lectores-production",
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_NAME": "Triángulo de Lectores",
        "SITE_URL": "https://triangulodelectores.com",
        "SITE_LOCALE": "es-ES",
        "TURNSTILE_SITE_KEY": "REPLACE_WITH_PROD_TURNSTILE_SITE_KEY",
        "TURNSTILE_ENABLED": "true",
        "IMAGE_RESIZING": "true",
        "LOG_LEVEL": "warn"
      },
      "routes": [
        { "pattern": "triangulodelectores.com", "custom_domain": true },
        { "pattern": "www.triangulodelectores.com", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tdl-db-prod",
          "database_id": "REPLACE_WITH_PROD_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tdl-media-prod" }
      ],
      "kv_namespaces": [
        { "binding": "CACHE", "id": "REPLACE_WITH_PROD_CACHE_KV_ID" },
        { "binding": "CONFIG", "id": "REPLACE_WITH_PROD_CONFIG_KV_ID" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "MODERATION", "class_name": "ModerationCoordinator" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ModerationCoordinator"] }
      ],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "observability": { "enabled": true, "head_sampling_rate": 0.5 },
      "placement": { "mode": "smart" },
      "limits": { "cpu_ms": 50 },
      // Mantenimiento diario: purga de sesiones caducadas y retención de auditoría.
      "triggers": { "crons": ["0 4 * * *"] }
    }
  }
}
