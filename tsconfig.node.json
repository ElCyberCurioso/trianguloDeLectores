{
  // Herramientas que corren en Node: scripts, configuración de build y de tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "scripts/**/*",
    "drizzle.config.ts",
    "vitest.workspace.ts",
    "vitest.unit.config.ts",
    "vitest.integration.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules"]
}
