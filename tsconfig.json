{
  // Código que se ejecuta en Cloudflare Workers (workerd).
  // Sin `lib: DOM` a propósito: si alguien usa `document` o `window` aquí,
  // el typecheck falla en vez de romperse en producción.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types/2023-07-01", "@cloudflare/vitest-pool-workers"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/server/**/*",
    "src/db/**/*",
    "src/do/**/*",
    "src/types/**/*",
    "src/validation/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*"
  ],
  "exclude": ["node_modules", ".wrangler", "public/assets"]
}
