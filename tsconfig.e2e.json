{
  // Tests de extremo a extremo. El cuerpo de `page.evaluate()` corre dentro del
  // navegador, así que aquí sí hace falta `lib.DOM`; en el Worker y en los
  // scripts de Node sigue estando prohibida a propósito.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["tests/e2e/**/*", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
