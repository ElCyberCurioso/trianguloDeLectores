# Cabeceras para los assets estáticos servidos por Workers Static Assets.
# Las cabeceras de seguridad de las respuestas HTML las pone el Worker.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/admin.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
