# Cabeceras para los assets estáticos servidos por Workers Static Assets.
# Las cabeceras de seguridad de las respuestas HTML las pone el Worker.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Las tipografías nunca cambian sin cambiar de nombre: cache máxima.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Los recursos de marca cambian muy de tarde en tarde, pero su nombre es fijo:
# se cachean fuerte con revalidación en segundo plano.
/assets/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  X-Content-Type-Options: nosniff

/assets/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/admin.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json
